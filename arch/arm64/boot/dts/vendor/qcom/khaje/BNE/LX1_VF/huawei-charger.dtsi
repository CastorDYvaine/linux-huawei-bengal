&huawei_batt_info {
    shield_ct_sign = <1>;
};

&fake_i2c {
	sm5450@6F{
		pinctrl-0 = <&sm5450_main_irq_pins_default>;
		intr_gpio_num = <34>; /* direct defined GPIO num */
		intr_gpio = <&tlmm 34 0>;
		fcp_support = <0>;
		scp_support = <0>;
		ic_role = <1>;
	};

	hl7139@5F {
		pinctrl-0 = <&sm5450_main_irq_pins_default>;
		intr_gpio_num = <34>; /* direct defined GPIO num */
		intr_gpio = <&tlmm 34 0>;
		fcp_support = <0>;
		scp_support = <0>;
		ic_role = <1>;
		switching_frequency = <900>;
	};
};

&qupv3_se1_i2c {
	sm5450@6F{
		pinctrl-0 = <&sm5450_irq_pins_default>;
		intr_gpio_num = <85>; /* direct defined GPIO num */
		intr_gpio = <&tlmm 85 0>;
		fcp_support = <1>;
		scp_support = <1>;
		ic_role = <0>;
	};

	hl7139@5F {
		pinctrl-0 = <&sm5450_irq_pins_default>;
		intr_gpio_num = <85>; /* direct defined GPIO num */
		intr_gpio = <&tlmm 85 0>;
		fcp_support = <1>;
		scp_support = <1>;
		ic_role = <0>;
		switching_frequency = <900>;
	};
};

