#include "../../../lcdkit3.0/ags5/devkit_lcd_kit.dtsi"
&huawei_lcd_panel {
	compatible = "huawei,lcd_panel_type";
	/* auto_key_info @ name: product_id type: uint32 default: 0 */
	product_id = <13000>;
	/* auto_key_info @ name: product_type type: uint32 default: 0 */
	product_type = <0>;
	detect_type = <2>;
	/* auto_key_info @ name: gpio_id[2] type: int default: 0 */
	gpio_id = <52 68>;
	/* auto_key_info @ name: tp_reset_gpio type: uint32 default: 0 */
	tp_reset_gpio = <86>;
	bias_ctrl_type = <3>;
	/* auto_key_info @ name: vsp_gpio_id type: uint32 default: 0 */
	vsp_gpio_id = <65>;
	/* auto_key_info @ name: vsn_gpio_id type: uint32 default: 0 */
	vsn_gpio_id = <26>;
	/* auto_key_info @ name: lcd_reset_gpio type: uint32 default: 0 */
	lcd_reset_gpio = <82>;
	/* auto_key_info @ name: te_gpio type: uint32 default: 0 */
	te_gpio = <0>;
	/* auto_key_info @ name: bl_en_gpio type: uint32 default: 0 */
	bl_en_gpio = <27>;
	/* auto_key_info @ name: bl_is_dual type: uint32 default: 0 */
	bl_is_dual = <0>;
	/* auto_key_info @ name: bl_bias_together type: uint32 default: 1 */
	bl_bias_together = <0>;
	support_lcd_type = "LCD_KIT";
};

&mdss_dsi_phy0 {
	qcom,dsi-drive-adjustment = <1>;
	qcom,glbl-str-swi-cal-sel-ctrl = <0x01>;
	qcom,glbl-hstx-str-ctrl-0 = <0xff>;
	qcom,vreg-ctrl-0 = <0x52>;
};

&tlmm {
	bkl_active: bkl_active{
		mux {
			pins = "gpio27";
			function = "gpio";
		};

		config {
			pins = "gpio27";
			drive-strength = <2>;
			bias-disable;
		};
	};

	bkl_suspend: bkl_suspend{
		mux {
			pins = "gpio27";
			function = "gpio";
		};

		config {
			pins = "gpio27";
			drive-strength = <2>;
			bias-disable;
		};
	};
};

&qupv3_se1_i2c {
	status = "ok";

	tps65132@3e {
		compatible = "ti,tps65132";
		reg = <0x3e>;
		gpio_vsp_enable = <&tlmm 65 0x00>;
		gpio_vsn_enable = <&tlmm 26 0x00>;
		probe_no_init = <1>;
	};

	rt4801h@73 {
		compatible = "rt4801h_phy";
		reg = <0x73>;
		gpio_vsp_enable = <&tlmm 65 0x00>;
		gpio_vsn_enable = <&tlmm 26 0x00>;
		probe_no_init = <1>;
	};

	icn68116@3f {
		compatible = "icn68116_phy";
		reg = <0x3f>;
		gpio_vsp_enable = <&tlmm 65 0x00>;
		gpio_vsn_enable = <&tlmm 26 0x00>;
		probe_no_init = <1>;
	};

	hw_syh62758@2e {
