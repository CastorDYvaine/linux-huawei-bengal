&fm1230 {
	pinctrl-names = "default";
	pinctrl-0 = <&battct_swi_pins_default>;
	onewire-gpio = <&tlmm 83 0>;
	ow_reset_start_delay = <300>;
	ow_reset_sample_delay = <10>;
	ow_reset_end_delay = <60>;
	ow_write_start_delay = <2>;
	ow_write_low_delay = <53>;
	ow_write_high_delay = <6>;
	ow_write_end_delay = <50>;
	ow_read_start_delay = <1>;
	ow_read_sample_delay = <7>;
	ow_read_end_delay = <100>;
	status = "ok";
};

&fm1230_swi {
	status = "ok";
};

&huawei_batt_identify {
	pinctrl-names = "default";
	pinctrl-0 = <&battct_id_pins_default>;
	gpios = <&tlmm 108 0>;
	id_voltage_gpiov = <0 1>;
	id_sn_gpiov = <0 0>;
	status = "ok";
};

&huawei_batt_info {
	status = "ok";
	shield_ct_sign = <3>;
	battery_checker@0 {
		matchable = <&fm1230>;
		spare-cycles = <150>;
		status = "ok";
	};
};

&ship_mode {
	status = "ok";
};

&huawei_buck_charger {
	release_lock_support = <1>;
};

