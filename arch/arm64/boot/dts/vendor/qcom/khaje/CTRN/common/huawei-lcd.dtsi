&dsi_ctrn_290_105_6p7_qcom {
    qcom,mdss-dsi-pan-enable-dynamic-fps;
    qcom,dsi-supported-dfps-list = <90 60 30>;
    qcom,min-refresh-rate = <30>;
    qcom,max-refresh-rate = <90>;
    qcom,mdss-dsi-pan-fps-update = "dfps_immediate_porch_mode_vfp";
};
&dsi_ctrn_330_105_6p7_qcom {
    qcom,mdss-dsi-pan-enable-dynamic-fps;
    qcom,dsi-supported-dfps-list = <90 60 30>;
    qcom,min-refresh-rate = <30>;
    qcom,max-refresh-rate = <90>;
    qcom,mdss-dsi-pan-fps-update = "dfps_immediate_porch_mode_vfp";
};
&dsi_ctrn_330_a07_6p7_qcom {
    qcom,mdss-dsi-pan-enable-dynamic-fps;
    qcom,dsi-supported-dfps-list = <90 60 30>;
    qcom,min-refresh-rate = <30>;
    qcom,max-refresh-rate = <90>;
    qcom,mdss-dsi-pan-fps-update = "dfps_immediate_porch_mode_vfp";
};

&sde_dsi {
    qcom,dsi-default-panel = <&dsi_ctrn_auo_otm1901a_5p2_1080p_video_default>;
};
