&tlmm {
	bq2560x_irq_pins_default: bq2560x_irq_pins_default {
		mux {
			pins = "gpio35";
			function = "gpio";
		};
		config {
			pins = "gpio35";
			drive-strength = <2>;
			bias-pull-up;
		};
	};

	bq2560x_cd_pins_default: bq2560x_cd_pins_default {
		mux {
			pins = "gpio36";
			function = "gpio";
		};
		config {
			pins = "gpio36";
			drive-strength = <2>;
			bias-pull-up;
		};
	};

	rt9426_irq_pins_default: rt9426_irq_pins_default {
		mux {
			pins = "gpio106";
			function = "gpio";
		};
		config {
			pins = "gpio106";
			drive-strength = <2>;
			bias-pull-up;
		};
	};

	rt1711h_irq_pins_default: rt1711h_irq_pins_default {
		mux {
			pins = "gpio107";
			function = "gpio";
		};
		config {
			pins = "gpio107";
			drive-strength = <2>;
			bias-pull-up;
			input-enable;
		};
	};

	hl7136_irq_pins_default: hl7136_irq_pins_default {
		mux {
			pins = "gpio34";
			function = "gpio";
		};
		config {
			pins = "gpio34";
			drive-strength = <2>;
			bias-pull-up;
			input-enable;
		};
	};

	sc8546_irq_pins_default: sc8546_irq_pins_default {
		mux {
			pins = "gpio34";
			function = "gpio";
		};
		config {
			pins = "gpio34";
			drive-strength = <2>;
			bias-pull-up;
			input-enable;
		};
	};

	mos_en_on: mos_en_on {
		mux {
			pins = "gpio105";
			function = "gpio";
		};

		config {
			pins = "gpio105";
			bias-disable;
			output-high;
			drive-strength = <2>; /* 2 MA */
		};
	};

	mos_en_off: mos_en_off {
		mux {
			pins = "gpio105";
			function = "gpio";
		};

		config {
			pins = "gpio105";
			bias-disable;
			output-low;
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};
};

&qupv3_se5_i2c {
	status = "ok";
	sc8546@6E {
		compatible = "sc8546";
		reg = <0x6E>;
		pinctrl-names = "default";
		pinctrl-0 = <&sc8546_irq_pins_default>;
		intr_gpio_num = <34>; /* direct defined GPIO num */
		intr_gpio = <&tlmm 34 0>;
		fcp_support = <1>;
		scp_support = <1>;
		ufcs_support = <1>;
		sense_r_actual = <20>;
		sense_r_config = <20>;
		i2c_recovery = <1>;
		i2c_recovery_addr = <0x6F>;
		switching_frequency = <500>;
		switching_frequency_shift = <1>;
		ic_role = <0>;
		status = "ok";
	};

	hl7136@4E {
		compatible = "hl7136";
		reg = <0x4E>;
		pinctrl-names = "default";
		pinctrl-0 = <&hl7136_irq_pins_default>;
		intr_gpio_num = <34>; /* direct defined GPIO num */
		intr_gpio = <&tlmm 34 0>;
		sense_r_actual = <10>;
		sense_r_config = <25>;
		fcp_support = <1>;
		scp_support = <1>;
		ufcs_support = <1>;
		switching_frequency = <500>;
		ic_role = <0>;
		ignore_get_cable_info = <1>;
		less_leak_cur = <1>;
		status = "ok";
	};
};

&qupv3_se2_i2c {
	status = "ok";

	/* auto_key_info @ name: charger_i2c type: uint32 default: 0 */
	charger_i2c = <3>;
	/* auto_key_info @ name: fuelgague_i2c type: uint32 default: 0 */
	fuelgague_i2c = <3>;
	/* auto_key_info @ name: UefiBootUpThreshold type: uint32 default: 0 */
	UefiBootUpThreshold = <2500>;

	bq2560x_charger@6B {
		compatible = "huawei,bq2560x_charger";
		reg = <0x6B>;
		pinctrl-names = "bq2560x_irq_pins_default",
					"bq2560x_cd_pins_default";
		pinctrl-0 = <&bq2560x_irq_pins_default>;
		pinctrl-1 = <&bq2560x_cd_pins_default>;
		gpio_int = <&tlmm 35 0>;
		gpio_cd = <&tlmm 36 0>;
		gpio_cd_need = <1>;
		bat_comp = <80>;
		vclamp = <224>;
		rilim = <124>;
		adc_channel_iin = <5>;
		adc_channel_vbat_sys = <14>;
		fcp_support = <0>;
		hiz_iin_limit = <1>;
		custom_cv = <4480>;
		charge-detect-enable;
		enable_redo_bc12; /* Identified non-standard,do bc1.2 again */
		sdp_redo_bc12; /* Identified sdp,do bc1.2 again */
		no_need_change_iterm;
		disable_batfet_rst_en = <1>; /* if support shipmode, need disable batfet_rst_en */
		shipmode_clear_hiz = <1>;
		status = "ok";
	};

	rt9471@53 {
		compatible = "richtek,rt9471";
		reg = <0x53>;
		pinctrl-names = "bq2560x_irq_pins_default",
					"bq2560x_cd_pins_default";
		pinctrl-0 = <&bq2560x_irq_pins_default>;
		pinctrl-1 = <&bq2560x_cd_pins_default>;
		rt,intr_gpio = <&tlmm 35 0>;
		rt,ceb_gpio = <&tlmm 36 0>;
		charger_name = "rt9471";
		interrupt-names = "wdt", "vac_ov", "otg_fault";
		ichg = <1000>; /* mA */
		aicr = <500>; /* mA */
		mivr = <4400>; /* mV */
		cv = <4480>; /* mV */
		custom_cv = <4480>;
		ieoc = <150>; /* mA */
		safe-tmr = <20>; /* hour */
		wdt = <40>; /* sec */
		mivr-track = <0>;
		en-te;
		/* en-jeita; */
		/* ceb-invert; */
		/* dis-i2c-tout; */
		en-qon-rst;
		/* auto-aicr; */
		charge-detect-enable;
		enable_redo_bc12;
		write_back_vacovp;
		status = "ok";
	};

	cw2217@64 {
		compatible = "cellwise,cw2217";
		reg = <0x64>;
		cw,bat_name = "battery_gauge";
		status = "ok";
		ground_loop_comp_en = <1>;
		ground_loop_comp_rcomp = <60>;
		en_soft_reset = <1>;
		vbat_soc_table =
			"3820", "3846", "36",
			"3846", "3883", "43",
			"3883", "3931", "49",
			"3931", "3998", "55",
			"3998", "4067", "62",
			"4067", "4132", "68",
			"4132", "4209", "74",
			"4209", "4286", "81",
			"4286", "4355", "87",
			"4355", "4429", "94",
			"4429", "4450", "100";
		battery0 {
			batt_name = "BYTCLE_7600_4480_v0";
			#include "../../../huawei_charger/cw2217_BYTCLE_7600mAh_4V45_BT274.dtsi"
		};
		battery1 {
			batt_name = "BNTCDE_7600_4480_v0";
			#include "../../../huawei_charger/cw2217_BNTCDE_7600mAh_4V45_BT274.dtsi"
		};
		battery2 {
			batt_name = "BITCAE_7600_4480_v0";
			#include "../../../huawei_charger/cw2217_BITCAE_7600mAh_4V45_BT274.dtsi"
		};
	};

	rt9426_battery@55 {
		reg = <0x55>;
		rt,bat_name = "rt_battery";
		compatible = "richtek,rt9426";
		pinctrl-names = "default";
		pinctrl-0 = <&rt9426_irq_pins_default>;
		rt9426,gpio-intb = <&tlmm 106 0x0>;
		need_reset_version = <9>;
		rt_config_ver = <12>; /* NOTICE: need increase 1 ,when  update batter model param */
		ntc_compensation_is = <1>;
		ground_loop_comp_en = <1>;
		ground_loop_comp_rcomp = <40>;
		status = "ok";
		battery0 {
			batt_name = "BYTCLE_7600_4480_v0";
			#include "../../../huawei_charger/rt9426_BYTCLE_7600mAh_4V48_BT274.dtsi"
		};
		battery1 {
			batt_name = "BNTCDE_7600_4480_v0";
			#include "../../../huawei_charger/rt9426_BNTCDE_7600mAh_4V48_BT274.dtsi"
		};
		battery2 {
			batt_name = "BITCAE_7600_4480_v0";
			#include "../../../huawei_charger/rt9426_BITCAE_7600mAh_4V48_BT274.dtsi"
		};
	};

	rt1711_i2c@4e {
		compatible = "richtek,rt1711";
		reg = <0x4e>;
		status = "ok";
		pinctrl-names = "default";
		pinctrl-0 = <&rt1711h_irq_pins_default>;
		rt1711pd,intr_gpio = <&tlmm 107 0>;
		rt1711pd,intr_gpio_num = <107>;
		rt-tcpc,vconn_supply = <1>;
		rt-dual,supported_modes = <0>; /* 0: dfp/ufp, 1: dfp, 2: ufp */
		rt-tcpc,name = "type_c_port0"; /* tcpc_device's name */
		rt-tcpc,role_def = <5>; /* 0: Unknown, 1: SNK Only, 2: SRC Only, 3: DRP, 4: Try.SRC, 5: Try.SNK */
		rt-tcpc,rp_level = <0>; /* 0: Default, 1: 1.5, 2: 3.0 */
		rt-tcpc,notifier_supply_num = <0>; /* the number of notifier supply */
		pd-data {
			pd,vid = <0x12d1>;
			pd,pid = <0x107e>;
			pd,source-pdo-size = <1>;
			pd,source-pdo-data = <0x00019064>;
			pd,source-cap-ext = /bits/ 8 <0xd1 0x12 0x7e 0x10
				0x00 0x00 0x00 0x00
				0x00 0x00 0x00 0x00
				0x00 0x00 0x00 0x00
				0x01 0x0b 0x00 0x00
				0x0a 0x00 0x01 0x05
				0x00>;
			pd,sink-pdo-size = <1>;
			pd,sink-pdo-data = <0x000190c8> ;   /* 0x0002d0c8 : 9V, 2A */
			pd,sink-cap-ext = /bits/ 8 <0xd1 0x12 0x7e 0x10
				0x00 0x00 0x00 0x00
				0x00 0x00 0x01 0x00
				0x00 0x00 0x00 0x00
				0x01 0x0b 0x01 0x0a
				0x0a 0x00 0x00 0x00>;

			pd,id-vdo-size = <4>;
			pd,id-vdo-data = <0xec0012d1 0x0 0x107e0000 0x11000001>;
			bat,nr = <1>;
			bat-info0 {
				bat,vid = <0x12d1>;
				bat,pid = <0x107e>;
				bat,mfrs = "bat1";
				bat,design_cap = <7600>;
			};

			/*
			No DP
			pd,id-vdo-size = <3>;
			pd,id-vdo-data = <0x500029cf 0x0 0x00010000>;
			With DP
			pd,id-vdo-size = <4>;
			pd,id-vdo-data = <0xec0029cf 0x0 0x00010000 0x11000001>;
			*/
		};
		dpm_caps {
			local_dr_power;
			local_dr_data;
			// local_ext_power;
			local_usb_comm;
			// local_usb_suspend;
			// local_high_cap;
			// local_give_back;
			local_no_suspend;
			local_vconn_supply;

			attemp_enter_dp_mode;
			attemp_discover_cable;
			attemp_discover_id;

			/* 0: disable, 1: prefer_snk, 2: prefer_src */
			pr_check = <0>;
			// pr_reject_as_source;
			// pr_reject_as_sink;
			pr_check_gp_source;
			// pr_check_gp_sink;

			/* 0: disable, 1: prefer_ufp, 2: prefer_dfp */
			dr_check = <0>;
			// dr_reject_as_dfp;
			// dr_reject_as_ufp;

			snk_prefer_low_voltage;
			// snk_ignore_mismatch_current;
		};
		displayport {
			/* connection type = "both", "ufp_d", "dfp_d" */
			1st_connection = "dfp_d";
			2nd_connection = "dfp_d";
			signal,dp_v13;
			//signal,dp_gen2;
			//usbr20_not_used;
			typec,receptacle;
			ufp_d {
				//pin_assignment,mode_a;
				//pin_assignment,mode_b;
				//pin_assignment,mode_c;
				//pin_assignment,mode_d;
				//pin_assignment,mode_e;
			};
			dfp_d {
				/* Only support mode C & D */
				//pin_assignment,mode_a;
				//pin_assignment,mode_b;
				pin_assignment,mode_c;
				pin_assignment,mode_d;
				pin_assignment,mode_e;
				pin_assignment,mode_f;
			};
		};
	};
};

