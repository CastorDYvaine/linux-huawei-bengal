		"1", "0", "5000", "0", "0",
		"0", "-1", "0", "1", "1";
	ic_para2 =
		"0", "0", "8500", "0", "0",
		"1", "1", "5000", "0", "1";
	mode_para =
		"lvc_mode", "ic_para1",
		"sc_mode", "ic_para2";
