		"CAE", "10", "20", "volt_para",
		"CAE", "20", "35", "volt_para1",
		"CAE", "35", "45", "volt_para2",
		"CGL", "10", "20", "volt_para",
		"CGL", "20", "35", "volt_para1",
		"CGL", "35", "45", "volt_para2",
		"CDE", "10", "20", "volt_para",
                "CDE", "20", "35", "volt_para1",
                "CDE", "35", "45", "volt_para2";
	vbat_comp_para =
		"default", "15", "5",
		"bq25970", "10", "10",
		"rt9759", "15", "15";
	vstep_para =
		"2000", "80";
	10v2p25a_cur_para =
		"-32767", "5500",  "2000",
		"5500",   "9000",  "2500",
		"9000",   "10000", "2250",
		"10000",  "10500", "2000",
		"10500",  "32767", "1500";
	10v2p25a_car_cur_para =
		"-32767", "5500",  "2000",
		"5500",   "9000",  "2500",
		"9000",   "10000", "2250",
		"10000",  "32767", "2000";
	adp_qtr_a_10v2p25a_cur_para =
		"-32767", "5500",  "4000",
		"5500",   "9000",  "2500",
		"9000",   "10000", "2250",
		"10000",  "10500", "2000",
		"10500",  "32767", "1500";
	adp_qtr_c_20v3a_cur_para =
		"-32767", "10300", "4000",
		"10300",  "32767", "3000";
	10v4a_cur_para =
		"-32767", "11000", "4000";
	compensate_r = <0>;
	cc_cable_detect_enable = <1>;
