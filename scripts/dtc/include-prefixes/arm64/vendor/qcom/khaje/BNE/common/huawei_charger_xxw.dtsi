&tlmm {
	bq2560x_irq_pins_default: bq2560x_irq_pins_default {
		mux {
			pins = "gpio35";
			function = "gpio";
		};
		config {
			pins = "gpio35";
			drive-strength = <2>;
			bias-pull-up;
		};
	};
	
	bq2560x_cd_pins_default: bq2560x_cd_pins_default {
		mux {
			pins = "gpio36";
			function = "gpio";
		};
		config {
			pins = "gpio36";
			drive-strength = <2>;
			bias-pull-up;
		};
	};

	bq25970_main_irq_pins_default: bq25970_main_irq_pins_default {
		mux {
			pins = "gpio34";
			function = "gpio";
		};
		config {
			pins = "gpio34";
			drive-strength = <2>;
			bias-pull-up;
			input-enable;
		};
	};

	sm5450_main_irq_pins_default: sm5450_main_irq_pins_default {
		mux {
			pins = "gpio34";
			function = "gpio";
		};
		config {
			pins = "gpio34";
			drive-strength = <2>;
			bias-pull-up;
			input-enable;
		};
	};

	sm5450_irq_pins_default: sm5450_irq_pins_default {
		mux {
			pins = "gpio85";
			function = "gpio";
		};
		config {
			pins = "gpio85";
			drive-strength = <2>;
			bias-pull-up;
			input-enable;
		};
	};

	rt9426_irq_pins_default: rt9426_irq_pins_default {
		mux {
			pins = "gpio106";
			function = "gpio";
		};
		config {
			pins = "gpio106";
			drive-strength = <2>;
			bias-pull-up;
		};
	};

	rt1711h_irq_pins_default: rt1711h_irq_pins_default {
		mux {
			pins = "gpio107";
			function = "gpio";
		};
		config {
			pins = "gpio107";
			drive-strength = <2>;
			bias-pull-up;
			input-enable;
		};
	};

	battct_swi_pins_default: battct_swi_pins_default {
		mux {
			pins = "gpio83";
			function = "gpio";
		};
		config {
			pins = "gpio83";
			input-enable;
		};
	};
	battct_id_pins_default: battct_id_pins_default {
		mux {
			pins = "gpio108";
			function = "gpio";
		};
		config {
			pins = "gpio108";
			bias-disabled;
			output-high;
		};
	};

	mos_en_on: mos_en_on {
		mux {
			pins = "gpio105";
			function = "gpio";
		};

		config {
			pins = "gpio105";
			bias-disable;
			output-high;
			drive-strength = <2>; /* 2 MA */
		};
	};

	mos_en_off: mos_en_off {
		mux {
			pins = "gpio105";
			function = "gpio";
		};

		config {
			pins = "gpio105";
			bias-disable;
			output-low;
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	fake_i2c_active: fake_i2c_active {
		mux {
			/* sda, scl */
			pins = "gpio93","gpio67";
			function = "gpio";
		};
		config {
			pins = "gpio93","gpio67";
			bias-pull-up; /* PULL UP*/
			drive-strength = <2>; /* 2 MA */
		};
	};

	fake_i2c_sleep: fake_i2c_sleep {
		mux {
			/* sda, scl */
			pins = "gpio93","gpio67";
			function = "gpio";
		};
		config {
			pins = "gpio93","gpio67";
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};
};

&fake_i2c {
	compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		gpios= <&tlmm 93 0>, <&tlmm 67 0>;
		pinctrl-names = "fake_i2c_active", "fake_i2c_sleep";
		pinctrl-0 = <&fake_i2c_active>;
		pinctrl-1 = <&fake_i2c_sleep>;
		i2c-gpio,delay-us = <4>;
		i2c-gpio,timeout-ms = <20>;
		i2c-gpio,sda-open-drain;
		i2c-gpio,scl-open-drain;
	status = "okay";
	bq25970@65 {
		compatible = "bq25970";
		pinctrl-names = "default";
		pinctrl-0 = <&bq25970_main_irq_pins_default>;
		gpio_int = <&tlmm 34 0>;
		switching_frequency = <675>;
		sense_r_config = <20>;
		sense_r_actual = <20>;
		reg = <0x65>;
		ic_role = <1>;
		ibus_low_deglitch = <5>;
		resume_need_wait_i2c = <1>;
		mount_on_fake_i2c = <1>;
		status = "ok";
	};

	sm5450@6F{
		compatible = "sm5450";
		reg = <0x6F>;
		pinctrl-names = "default";
		pinctrl-0 = <&sm5450_irq_pins_default>;
		intr_gpio_num = <85>; /* direct defined GPIO num */
		intr_gpio = <&tlmm 85 0>;
		fcp_support = <1>;
		scp_support = <1>;
		sc_ibus_ocp = <3300>;
		sense_r_actual = <20>;
		ic_role = <1>;
		mount_on_fake_i2c = <1>;
		status = "ok";
	};

	hl7139@5F {
		compatible = "hl7139";
		reg = <0x5F>;
		pinctrl-names = "default";
		pinctrl-0 = <&sm5450_irq_pins_default>;
		intr_gpio_num = <85>; /* direct defined GPIO num */
		intr_gpio = <&tlmm 85 0>;
		fcp_support = <1>;
		scp_support = <1>;
		sense_r_actual = <20>;
		vbat_ovp_para = <4600>;
		sc_ibus_ocp = <3600>;
		sc_ibat_ocp = <7000>;
		switching_frequency = <1300>;
		tdie_regulation = <110>;
		ic_role = <1>;
		mount_on_fake_i2c = <1>;
		status = "ok";
	};
};

&qupv3_se2_i2c {
	status = "disabled";
};

&qupv3_se1_i2c {
	status = "ok";
	awinic@64 {
		status = "disabled";
	};

	bq2560x_charger@6B{
		compatible = "huawei,bq2560x_charger";
		reg = <0x6B>;
		pinctrl-names = "bq2560x_irq_pins_default",
						"bq2560x_cd_pins_default";
		pinctrl-0 = <&bq2560x_irq_pins_default>;
		pinctrl-1 = <&bq2560x_cd_pins_default>;
		gpio_int = <&tlmm 35 0>;
		gpio_cd = <&tlmm 36 0>;
		bat_comp = <80>;
		vclamp = <224>;
		rilim = <124>;
		adc_channel_iin = <5>;
		adc_channel_vbat_sys = <14>;
		fcp_support = <0>;
		hiz_iin_limit = <1>;
		custom_cv = <4496>;
		charge-detect-enable;
		enable_redo_bc12;
		no_need_change_iterm;
		status = "ok";
	};

	rt9471@53 {
		compatible = "richtek,rt9471";
		reg = <0x53>;
		pinctrl-names = "bq2560x_irq_pins_default",
						"bq2560x_cd_pins_default";
		pinctrl-0 = <&bq2560x_irq_pins_default>;
		pinctrl-1 = <&bq2560x_cd_pins_default>;
		rt,intr_gpio = <&tlmm 35 0>;
		rt,ceb_gpio = <&tlmm 36 0>;
		charger_name = "rt9471";
		interrupt-names = "wdt", "vac_ov", "otg_fault";
		ichg = <1000>; /* mA */
		aicr = <500>; /* mA */
		mivr = <4400>; /* mV */
		cv = <4440>; /* mV */
		custom_cv = <4464>;
		ieoc = <150>; /* mA */
		safe-tmr = <20>; /* hour */
		wdt = <40>; /* sec */
		mivr-track = <0>;
		en-te;
		/* en-jeita; */
		/* ceb-invert; */
		/* dis-i2c-tout; */
		en-qon-rst;
		/* auto-aicr; */
		charge-detect-enable;
		enable_redo_bc12;
		status = "ok";
	};

	bq25970@65 {
		compatible = "bq25970";
		pinctrl-names = "default";
		pinctrl-0 = <&bq25970_main_irq_pins_default>;
		gpio_int = <&tlmm 34 0>;
		switching_frequency = <675>;
		sense_r_config = <20>;
		sense_r_actual = <20>;
		reg = <0x65>;
		ic_role = <0>;
		ibus_low_deglitch = <5>;
		resume_need_wait_i2c = <1>;
		status = "ok";
	};

	sm5450@6F{
		compatible = "sm5450";
		reg = <0x6F>;
		pinctrl-names = "default";
		pinctrl-0 = <&sm5450_main_irq_pins_default>;
		intr_gpio_num = <34>; /* direct defined GPIO num */
		intr_gpio = <&tlmm 34 0>;
		fcp_support = <0>;
		scp_support = <0>;
		sc_ibus_ocp = <3300>;
		sense_r_actual = <20>;
		ic_role = <0>;
		status = "ok";
	};

	hl7139@5F {
		compatible = "hl7139";
		reg = <0x5F>;
		pinctrl-names = "default";
		pinctrl-0 = <&sm5450_main_irq_pins_default>;
		intr_gpio_num = <34>; /* direct defined GPIO num */
		intr_gpio = <&tlmm 34 0>;
		fcp_support = <0>;
		scp_support = <0>;
		sense_r_actual = <20>;
		vbat_ovp_para = <4600>;
		sc_ibus_ocp = <3600>;
		sc_ibat_ocp = <7000>;
		switching_frequency = <1300>;
		tdie_regulation = <110>;
		ic_role = <0>;
		status = "ok";
	};

	cw2217@64 {
		compatible = "cellwise,cw2217";
		reg = <0x64>;
		cw,bat_name = "battery_gauge";
		status = "ok";
		ground_loop_comp_en = <1>;
		ground_loop_comp_rcomp = <40>;
		battery0{
			batt_name = "BNTCAE_4400_4480_v0";
			#include "../../../huawei_charger/cw2217_BNTCAE_4400mAh_4V48_BT266.dtsi"
		};
		battery1{
			batt_name = "BCYCGL_4400_4480_v0";
			#include "../../../huawei_charger/cw2217_BCYCGL_4400mAh_4V48_BT266.dtsi"
		};
		battery2{
			batt_name = "BYTCDE_4400_4480_v0";
			#include "../../../huawei_charger/cw2217_BYTCDE_4400mAh_4V48_BT266.dtsi"
		};
	};

	rt9426_battery@55{
		reg = <0x55>;
		rt,bat_name = "rt_battery";
		compatible = "richtek,rt9426";
		pinctrl-names = "default";
		pinctrl-0 = <&rt9426_irq_pins_default>;
		rt9426,gpio-intb = <&tlmm 106 0x0>;
		need_reset_version = <9>;
		rt_config_ver = <15>; /* NOTICE: need increase 1 ,when update batter model param */
		ntc_compensation_is = <1>;
		ground_loop_comp_en = <1>;
		ground_loop_comp_rcomp = <40>;
		status = "ok";
		battery0{
			batt_name = "BNTCAE_4400_4480_v0";
			#include "../../../huawei_charger/rt9426_BNTCAE_4400mAh_4V48_BT266.dtsi"
		};
		battery1{
			batt_name = "BCYCGL_4400_4480_v0";
			#include "../../../huawei_charger/rt9426_BCYCGL_4400mAh_4V48_BT266.dtsi"
		};
		battery2{
			batt_name = "BYTCDE_4400_4480_v0";
			#include "../../../huawei_charger/rt9426_BYTCDE_4400mAh_4V48_BT266.dtsi"
		};
	};

	sh366101@5A {
		compatible = "sh,sh366101";
		reg = <0x5A>;
		sh,bat_name = "battery_gauge";
		test_data = <100>;
		status = "ok";
		battery0{
			batt_name = "BNTCAE_4400_4480_v0";
			#include "../../../huawei_charger/sh366101_BNTCAE_4400mAh_4V48_BT266.dtsi"
		};
		battery1{
			batt_name = "BCYCGL_4400_4480_v0";
			#include "../../../huawei_charger/sh366101_BNTCAE_4400mAh_4V48_BT266.dtsi"
		};
		battery2{
			batt_name = "BYTCDE_4400_4480_v0";
			#include "../../../huawei_charger/sh366101_BYTCDE_4400mAh_4V48_BT266.dtsi"
		};
	};

	rt1711_i2c@4e {
		compatible = "richtek,rt1711";
		reg = <0x4e>;
		status = "ok";
		pinctrl-names = "default";
		pinctrl-0 = <&rt1711h_irq_pins_default>;
		rt1711,irq_pin = <&tlmm 107 0>;
		rt-dual,supported_modes = <0>; /* 0: dfp/ufp, 1: dfp, 2: ufp */
		rt-tcpc,name = "type_c_port0"; /* tcpc_device's name */
		rt-tcpc,role_def = <4>; /* 0: SNK Only, 1: SRC Only, 2: DRP, 3: Try.SRC, 4: Try.SNK */
		rt-tcpc,rp_level = <0>; /* 0: Default, 1: 1.5, 2: 3.0 */
		rt-tcpc,en_temporary_lock = <1>; /* add for qcom6225, attach_wake_lock */
		rt-tcpc,notifier_supply_num = <0>; /* the number of notifier supply */
		pd-data {
			pd,source-pdo-size = <1>;
			pd,source-pdo-data = <0x00019064>;  /*<0x019014>;*/

			pd,sink-pdo-size = <2>;
			pd,sink-pdo-data = <0x000190c8 0x0002d0c8> ;   /* 0x0002d0c8 : 9V, 2A */

			/*
			No DP
			pd,id-vdo-size = <3>;
			pd,id-vdo-data = <0x500029cf 0x0 0x00010000>;
			With DP
			pd,id-vdo-size = <4>;
			pd,id-vdo-data = <0xec0029cf 0x0 0x00010000 0x11000001>;
			*/

			pd,id-vdo-size = <4>;
			pd,id-vdo-data = <0xec0012d1 0x0 0x107e0000 0x11000001>;
		};
		dpm_caps {
			local_dr_power;
			local_dr_data;
			// local_ext_power;
			local_usb_comm;
			// local_usb_suspend;
			// local_high_cap;
			// local_give_back;
			local_no_suspend;
			local_vconn_supply;

			attemp_enter_dp_mode;
			attemp_discover_cable;
			attemp_discover_id;

			/* 0: disable, 1: prefer_snk, 2: prefer_src */
			pr_check = <0>;
			// pr_reject_as_source;
			// pr_reject_as_sink;
			pr_check_gp_source;
			// pr_check_gp_sink;

			/* 0: disable, 1: prefer_ufp, 2: prefer_dfp */
			dr_check = <0>;
			// dr_reject_as_dfp;
			// dr_reject_as_ufp;

			snk_prefer_low_voltage;
			// snk_ignore_mismatch_current;
		};
		displayport {
			/* connection type = "both", "ufp_d", "dfp_d" */
			1st_connection = "dfp_d";
			2nd_connection = "dfp_d";
			signal,dp_v13;
			//signal,dp_gen2;
			//usbr20_not_used;
			typec,receptacle;
			ufp_d {
				//pin_assignment,mode_a;
				//pin_assignment,mode_b;
				//pin_assignment,mode_c;
				//pin_assignment,mode_d;
				//pin_assignment,mode_e;
			};
			dfp_d {
				/* Only support mode C & D */
				//pin_assignment,mode_a;
				//pin_assignment,mode_b;
				pin_assignment,mode_c;
				pin_assignment,mode_d;
				pin_assignment,mode_e;
				pin_assignment,mode_f;
			};
		};
	};
};

&charge_manager {
	compatible = "huawei,charge_manager";
	pd_support = <1>;
	support_usb_psy = <1>;
	status = "ok";
};

&buck_charge_ic {
	compatible = "huawei,buck_charge_ic";
	ic_type = <1>;
	status = "ok";
};

&direct_charge_ps {
	compatible = "huawei,direct_charge_ps";
	status = "ok";
};
&direct_charge_ic {
	/* ic_index  path_index  max_ibat  ibat_sample_point  vbat_sample_point */
	ic_para1 =
		"0", "0", "5000", "0", "0",
		"1", "-1", "0", "1", "0";
	ic_para2 =
		"0", "0", "6500", "0", "0",
		"1", "1", "6500", "1", "1";
	mode_para =
		"lvc_mode", "ic_para1",
		"sc_mode", "ic_para2";
        use_coul_ibat = <1>;
	status = "ok";
};

&direct_charge_comp {
	compensation_mode = <3>;
	leakage_r = <1100>;
	compensate_r = <9>;
	/* The vbat_samp_point_para table is used to find the comp relationship between chips */
	/* Calculate all compensation values of the same index */
	/* as the final compensation of the chip */
	/* Separately calculate positive and negative poles */
	/* ic_index  p_index  n_index */
	vbat_samp_point_para =
		"0", "0", "0",
		"1", "1", "1";
	status = "ok";
};

&huawei_buck_charger{
	release_lock_support = <1>;
};

&direct_charger{
	use_5A = <1>;
	need_wired_sw_off = <0>;
	volt_para =
		"4080", "4300", "4000",
		"4230", "4000", "2800",
		"4500", "2800", "1200";
	vbat_comp_para =
		"default", "0", "0";
	compensate_r = <10>;
	cc_cable_detect_enable = <1>;
	max_dc_bat_vol = <4450>;
	vol_err_th = <250>;
	full_path_res_max = <280>;
	scp_work_on_charger = <1>;
	init_delt_vset = <400>;
	standard_cable_full_path_res_max = <330>;
	first_cc_stage_timer_in_min = <5>;
	stage_need_to_jump = "1";
	low_temp_hysteresis = <5>;
	temp_para =
		"-32767", "10", "0",
		"10", "45", "5000",
		"45", "32767", "0";
	rt_test_para =
		"2000", "105"; /* rt_curr_th rt_test_time */
	status = "ok";
};

