&bolero {
	wcd937x-codec {
		qcom,cdc-micbias1-mv = <2700>;
		qcom,cdc-micbias2-mv = <2700>;
		qcom,cdc-micbias3-mv = <2700>;
	};
};

&bengal_snd {
	always_enable_micbias_after_insert = "true";
	disable_elect_insert_irq = "true";
};

&tlmm {
	smartpakit_irq_pins: smartpakit_irq_pins {
		smartpakit_irq_default: smartpakit_irq_default {
			mux {
				pins = "gpio103", "gpio102";
				function = "gpio";
			};

			config {
				pins = "gpio103", "gpio102";
				bias-pull-up;
				input-enable;
			};
		};
	};
};

&huawei_audio_info {
	compatible = "hw,hw_audio_info";
	product_identifier = "STG";
	voice_vol_level = "10";
	pa_identifier = "smartpakit";
	smartpa_i2s = <1>;
	smartpa_num = "2";
	speaker_test_content = "main_right_speaker,main_left_speaker";
	status = "ok";
	hardware_info {
		mic_num = "2";
		direct_devices = "0x4000000";
		get_ec_in_hal = "true";
		voip_handset_concurrency = "true";
		voip_ap_algo_enable = "true";
		voip_scene_support = "true";
		need_mode_delay = "true";
		status = "ok";
		mic_content = "bottom:mainmic#top:submic";
	};

	audio_channel_rotation_info {
		angle="90";
		rotation_support= "true";
	};
};

&tlmm {
	audio_mic_en_on: audio_mic_en_on {
		mux {
			pins = "gpio111";
			function = "gpio";
		};

		config {
			pins = "gpio111";
			bias-disable;
			output-high;
			drive-strength = <2>; /* 2 MA */
		};
	};

	audio_mic_en_off: audio_mic_en_off {
		mux {
			pins = "gpio111";
			function = "gpio";
		};

		config {
			pins = "gpio111";
			bias-disable;
			output-low;
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};

	typec_ear_3v3_en_on: typec_ear_3v3_en_on {
		mux {
			pins = "gpio112";
			function = "gpio";
		};

		config {
			pins = "gpio112";
			drive-strength = <2>;
			bias-disable;
			output-high;
		};
	};

	typec_ear_3v3_en_off: typec_ear_3v3_en_off {
		mux {
			pins = "gpio112";
			function = "gpio";
		};

		config {
			pins = "gpio112";
			drive-strength = <2>;
			bias-pull-down;
			input-enable;
		};

	};

	smartpa1_reset: smartpa1_reset {
		mux {
			pins = "gpio108";
			function = "gpio";
		};

		config {
			pins = "gpio108";
			bias-disable;
			output-low;
			bias-pull-down; /* PULL DOWN */
			drive-strength = <2>; /* 2 MA */
		};
	};
};

&ana_hs {
	compatible = "huawei,ana_hs";
	status = "ok";
	ana_hs_core@0 {
		compatible = "huawei,ana_hs_core";
		pinctrl_used;  // use pinctrl to set ldo supply
		bus_type = <2>; // 0: gpio,  1: i2c,   2: pinctrl

		pinctrl-names = "mic_off", "mic_on", "ldo_off", "ldo_on";
		pinctrl-0 = <&audio_mic_en_off>;
		pinctrl-1 = <&audio_mic_en_on>;
		pinctrl-2 = <&typec_ear_3v3_en_off>;
		pinctrl-3 = <&typec_ear_3v3_en_on>;

		plugout_timing_optimization = <1>;
		plugin_status_stable_delay = <300>;
		status = "ok";
	};
};

&audio_hw_config {
	asr_enable = "true";
	vassistant_call = "true";
	cam_record_perf = "true";
	voip_perf = "true";
};

&qupv3_se1_i2c {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "ok";

	smartpa@35 {
		compatible = "huawei,smartpakit_i2c";
		reg = <0x35>;
		pa_num_by_same_i2c_addr = <2>;
		status = "ok";

		smartpa0 {
			/* 0 MAXIM, 1 NXP, 2 TI, 3 OTHER, 4:huawei customize */
			chip_vendor = <4>;
			/* refer to smartpakit.out_device prop */
			chip_id = <0>;
			chip_model = "01-02";
			status = "ok";

			/* reg_ctl node: a node contains three data<addr value ctl_type>
			 * ctl_type: 0 read reg(default), 1 write reg, 2 only time delay
			 * value:
			 *     read:  reg number(num >= 1)
			 *     write: reg value
			 *     delay: time delay
			 * time delay unit: msecs */
			version_regs = <0x03 1 0>;
			dump_regs = <0 256 0>;
			hw_reset {
				gpio_reset = <&tlmm 54 0>; // GPIO_54
				/* gpio_state node: a node contains two data<state delay>
				 * time delay unit: msecs */
				ctl_sequence = <1 1 0 1>;
			};
			irq_handler {
				gpio_irq = <&tlmm 102 0>; // GPIO_102
				/* 0x0 IRQF_TRIGGER_NONE, 0x1 IRQF_TRIGGER_RISING, 0x2 IRQF_TRIGGER_FALLING, 0x4 IRQF_TRIGGER_HIGH, 0x8 IRQF_TRIGGER_LOW*/
				irq_flags = <2>;
				/* whether or not need reset chip*/
				need_reset;
				rw_sequence = <
					0x10 1 0
					0x11 1 0
					0x13 1 0
					0x14 1 0
					0x40 1 0
					0x41 1 0
					0x42 1 0
				>;
			};
			regmap_cfg {
				reg_bits = <8>;
				val_bits = <16>;
				/* 0 REGCACHE_NONE, 1 REGCACHE_RBTREE, 2 REGCACHE_COMPRESSED, 3 REGCACHE_FLAT */
				cache_type = <0>;
				max_register = <0xff>;
				reg_defaults = <
					0x00 0x1801
					0x01 0x0014
				>;
			};
		};

		smartpa1 {
			/* 0 MAXIM, 1 NXP, 2 TI, 3 OTHER, 4:huawei customize */
			chip_vendor = <4>;
			/* refer to smartpakit.out_device prop */
			chip_id = <0>;
			chip_model = "06-01";
			/* maybe trigger one irq after some chip reset, ext. tas2560
			 * debounce wait time unit: msecs */
			reset_debounce_wait_time = <200>;
			sync_irq_debounce_time;
			status = "ok";

			/* reg_ctl node: a node contains three data<addr value ctl_type>
			 * ctl_type: 0 read reg(default), 1 write reg, 2 only time delay
			 * value:
			 *     read:  reg number(num >= 1)
			 *     write: reg value
			 *     delay: time delay
			 * time delay unit: msecs */
			version_regs = <0x00 1 0>;
			dump_regs = <0 256 0>;
			hw_reset {
				gpio_reset = <&tlmm 54 0>; // GPIO_54
				/* gpio_state node: a node contains two data<state delay>
				 * time delay unit: msecs */
				ctl_sequence = <0 1 1 1>;
			};
			irq_handler {
				gpio_irq = <&tlmm 102 0>; // GPIO_102
				/* 0x0 IRQF_TRIGGER_NONE, 0x1 IRQF_TRIGGER_RISING, 0x2 IRQF_TRIGGER_FALLING, 0x4 IRQF_TRIGGER_HIGH, 0x8 IRQF_TRIGGER_LOW*/
				irq_flags = <2>;
				/* whether or not need reset chip*/
				need_reset;
				rw_sequence = <
					0x00 8 0
					0x09 5 0
					0x12 3 0
					0x60 2 0
					0x78 1 0
					0x7a 1 0
				>;
			};
			regmap_cfg {
				reg_bits = <8>;
				val_bits = <16>;
				/* 0 REGCACHE_NONE, 1 REGCACHE_RBTREE, 2 REGCACHE_COMPRESSED, 3 REGCACHE_FLAT */
				cache_type = <0>;
				max_register = <0xff>;
			};
		};
	};

	smartpa@36 {
		compatible = "huawei,smartpakit_i2c";
		pinctrl-names = "default";
		pinctrl-0 = <&smartpa1_reset>;
		reg = <0x36>;
		pa_num_by_same_i2c_addr = <2>;
		status = "ok";

		smartpa0 {
			/* 0 MAXIM, 1 NXP, 2 TI, 3 OTHER, 4:huawei customize */
			chip_vendor = <4>;
			/* refer to smartpakit.out_device prop */
			chip_id = <1>;
			chip_model = "01-02";
			status = "ok";

			/* reg_ctl node: a node contains three data<addr value ctl_type>
			 * ctl_type: 0 read reg(default), 1 write reg, 2 only time delay
			 * value:
			 *     read:  reg number(num >= 1)
			 *     write: reg value
			 *     delay: time delay
			 * time delay unit: msecs */
			version_regs = <0x03 1 0>;
			dump_regs = <0 256 0>;
			hw_reset {
				gpio_reset = <&tlmm 108 0>; // GPIO_108
				/* gpio_state node: a node contains two data<state delay>
				 * time delay unit: msecs */
				ctl_sequence = <1 1 0 1>;
			};
			irq_handler {
				gpio_irq = <&tlmm 103 0>; // GPIO_103
				/* 0x0 IRQF_TRIGGER_NONE, 0x1 IRQF_TRIGGER_RISING, 0x2 IRQF_TRIGGER_FALLING, 0x4 IRQF_TRIGGER_HIGH, 0x8 IRQF_TRIGGER_LOW*/
				irq_flags = <2>;
				/* whether or not need reset chip*/
				need_reset;
				rw_sequence = <
					0x10 1 0
					0x11 1 0
					0x13 1 0
					0x14 1 0
					0x40 1 0
					0x41 1 0
					0x42 1 0
				>;
			};
			regmap_cfg {
				reg_bits = <8>;
				val_bits = <16>;
				/* 0 REGCACHE_NONE, 1 REGCACHE_RBTREE, 2 REGCACHE_COMPRESSED, 3 REGCACHE_FLAT */
				cache_type = <0>;
				max_register = <0xff>;
				reg_defaults = <
					0x00 0x1801
					0x01 0x0014
				>;
			};
		};

		smartpa1 {
			/* 0 MAXIM, 1 NXP, 2 TI, 3 OTHER, 4:huawei customize */
			chip_vendor = <4>;
			/* refer to smartpakit.out_device prop */
			chip_id = <1>;
