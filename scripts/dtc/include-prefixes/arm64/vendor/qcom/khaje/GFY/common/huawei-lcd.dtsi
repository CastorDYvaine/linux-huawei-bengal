		hw_ktz8864,backlight_ic_bias_enable_cmd = <0x01 0x00 0x00 0x00 0x00>;
		hw_ktz8864,backlight_ic_bias_disable_cmd = <0x01 0x00 0x00 0x00 0x00>;
