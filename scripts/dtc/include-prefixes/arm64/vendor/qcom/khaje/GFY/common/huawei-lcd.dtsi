		hw_ktz8864,backlight_ic_level_10000 = <1>;
		hw_ktz8864,backlight_ic_level_lsb_cmd = <0x03 0x04 0x00 0x07>;
		hw_ktz8864,backlight_ic_level_msb_cmd = <0x08 0x05 0x00 0xff>;
		hw_ktz8864,backlight_ic_bl_enable_cmd = <0x01 0x08 0x1f 0xff 0x00>;
