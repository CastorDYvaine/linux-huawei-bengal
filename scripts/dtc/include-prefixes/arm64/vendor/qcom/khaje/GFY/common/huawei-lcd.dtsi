		hw_ktz8864,backlight_ic_init_vsp_index = <9>;
		hw_ktz8864,backlight_ic_init_vsn_index = <10>;
		hw_ktz8864,dimming_support = <1>;
		hw_ktz8864,dimming_config = <0xD5>;
		hw_ktz8864,dimming_config_reg = <0x03>;
		hw_ktz8864,dimming_resume = <0x85>;

		hw_lm36274,bl_on_mdelay = <10>;
